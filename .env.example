# ── MongoDB Atlas ────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=omnitrace
COLLECTION_ID=demo_architecture

# ── Model providers ──────────────────────────────────────────────
# Groq (OpenAI-compatible API) is the current ASR + vision provider — swap
# to OpenAI later by changing LLM_BASE_URL, GROQ_API_KEY (rename), and the
# model IDs below. omnitrace/llm.py doesn't change; it's written against
# the OpenAI-shaped request/response contract both providers share.
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
MODEL_ASR=whisper-large-v3-turbo
MODEL_VISION=qwen/qwen3.6-27b

# Not used until P8 (grounded generation) — separate from the ASR/vision
# provider above; only needed if that phase stays on Anthropic.
ANTHROPIC_API_KEY=
MODEL_ANSWER=claude-opus-5
MODEL_BULK=claude-haiku-4-5

VOYAGE_API_KEY=
EMBED_TEXT=voyage-3-large
EMBED_MM=voyage-multimodal-3

# ── Retrieval backend ────────────────────────────────────────────
VECTOR_BACKEND=atlas
# VECTOR_BACKEND=numpy   # fallback if the Atlas vector index isn't READY yet

# ── Storage ───────────────────────────────────────────────────────
ASSET_ROOT=./data/assets

# ── Pipeline tuning ──────────────────────────────────────────────
MAX_VISUAL_STATES=60
LINK_CONFIRM=0.80
LINK_TENTATIVE=0.65
