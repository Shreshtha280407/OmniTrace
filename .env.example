# ── MongoDB Atlas ────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=omnitrace
COLLECTION_ID=demo_architecture

# ── Model providers ──────────────────────────────────────────────
# Groq (OpenAI-compatible API) is the ASR, vision, AND grounded-generation
# (P8) provider — swap to OpenAI later by changing LLM_BASE_URL,
# GROQ_API_KEY (rename), and the model IDs below. omnitrace/llm.py doesn't
# change; it's written against the OpenAI-shaped request/response contract
# both providers share. No Anthropic key is used anywhere in this build.
# Without GROQ_API_KEY set, POST /api/v1/query still returns the retrieved
# evidence bundle, just with missing_information instead of a generated
# answer (see generate/answer.py).
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
MODEL_ASR=whisper-large-v3-turbo
MODEL_VISION=qwen/qwen3.6-27b
MODEL_ANSWER=openai/gpt-oss-120b
MODEL_BULK=openai/gpt-oss-20b

VOYAGE_API_KEY=
EMBED_TEXT=voyage-3-large
EMBED_MM=voyage-multimodal-3

# ── Retrieval backend ────────────────────────────────────────────
VECTOR_BACKEND=atlas
# VECTOR_BACKEND=numpy   # fallback if the Atlas vector index isn't READY yet

# ── Storage ───────────────────────────────────────────────────────
ASSET_ROOT=./data/assets

# ── Pipeline tuning ──────────────────────────────────────────────
MAX_VISUAL_STATES=60
LINK_CONFIRM=0.80
LINK_TENTATIVE=0.65
