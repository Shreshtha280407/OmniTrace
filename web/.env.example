# ── OmniTrace frontend configuration ─────────────────────────────────────
# Copy to .env.local. Everything here is NEXT_PUBLIC_* and therefore shipped
# to the browser — never put a service key, model provider key, or the
# MongoDB URI in this file. Those belong to the backend's own .env.

# Base URL of the OmniTrace FastAPI service. The client appends /api/v1.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Must match COLLECTION_ID in the backend's .env — the frontend sends this
# as `collection_id` on POST /api/v1/query.
NEXT_PUBLIC_COLLECTION_ID=demo_architecture

# Where this app is served from. Used for absolute URLs in metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Demo mode ────────────────────────────────────────────────────────────
# `true` serves synthetic fixtures instead of calling the backend, and every
# screen showing them carries a visible "Demo data" marker. Opt-in only:
# when this is unset, a backend failure surfaces as a retryable error state
# rather than silently falling back to fixtures.
NEXT_PUBLIC_DEMO_MODE=false

# ── Optional: token-gated backend ────────────────────────────────────────
# The stock backend has no auth. If you put one behind a gateway, set a
# static token here and the client will send it on every request.
# NEXT_PUBLIC_API_TOKEN=
# NEXT_PUBLIC_API_AUTH_HEADER=Authorization
# NEXT_PUBLIC_API_AUTH_SCHEME=Bearer

# Request timeout in ms. Generous by default: POST /api/v1/sources runs probe
# and extraction synchronously, so a large video legitimately takes minutes.
# NEXT_PUBLIC_API_TIMEOUT_MS=120000
